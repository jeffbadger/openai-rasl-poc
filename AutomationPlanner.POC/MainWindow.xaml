<Window x:Class="AutomationPlanner.POC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Planner POC" Height="900" Width="1450" Loaded="Window_Loaded">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="180">
            <Grid Width="1400">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Execution Console" FontWeight="Bold" Margin="4" />
                <TextBox Grid.Row="1" Text="{Binding ConsoleText}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </Grid>
        </StatusBar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Planner Package Explorer" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Selected planner root"/>
                    <TextBox Text="{Binding SelectedPlannerRoot, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Browse Folder" Click="BrowseFolder_Click" Margin="0,0,6,0"/>
                        <Button Content="Reload Planner" Command="{Binding ReloadPlannerCommand}"/>
                    </WrapPanel>
                    <Button Content="Settings" Click="Settings_Click" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding PackageTree}" FontFamily="Consolas"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Scenario Workspace" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Name"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Load Scenario" Command="{Binding LoadScenarioCommand}" Margin="0,0,6,0"/>
                        <Button Content="Execute" Command="{Binding ExecuteCommand}" Margin="0,0,6,0"/>
                        <Button Content="Run All" Command="{Binding RunAllCommand}" Margin="0,0,6,0"/>
                        <Button Content="Export" Command="{Binding ExportCommand}"/>
                    </WrapPanel>
                </StackPanel>
                <TextBox Text="{Binding ScenarioJson, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
            </DockPanel>

            <DockPanel Grid.Column="2" Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="Execution Results" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TabControl>
                    <TabItem Header="Prompt Assembly"><TextBox Text="{Binding PromptAssembly}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="Raw Request"><TextBox Text="{Binding RawRequest}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="Raw Response"><TextBox Text="{Binding RawResponse}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="Planner JSON"><TextBox Text="{Binding PlannerJson}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="Validation"><TextBox Text="{Binding ValidationText}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></TabItem>
                    <TabItem Header="Diagnostics"><TextBox Text="{Binding DiagnosticsText}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></TabItem>
                </TabControl>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
